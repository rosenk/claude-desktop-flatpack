#!/bin/sh
# zypak (from org.electronjs.Electron2.BaseApp) redirects Chromium's setuid
# sandbox onto the Flatpak sandbox, so the renderers stay sandboxed without
# chrome-sandbox or --no-sandbox.
unset ELECTRON_RUN_AS_NODE

# Chromium writes the tray icon and media cover art to files in $TMPDIR and
# hands the desktop their paths; the sandbox's /tmp is private, so the host
# can't read them. The per-app runtime dir has the same path on both sides.
export TMPDIR="${XDG_RUNTIME_DIR}/app/${FLATPAK_ID}"

exec zypak-wrapper /app/lib/claude-desktop/claude-desktop --ozone-platform-hint=auto "$@"
